# Server Configuration
PORT=3000

# Local AI Runtime (Ollama + Gemma)
# Default local Ollama endpoint running Gemma (e.g., gemma3:1b or gemma2:2b)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
GEMMA_MODEL="gemma3:1b"

# Optional Hosted Gemma Inference Endpoint
# Compatible with OpenAI-compatible APIs (vLLM, Hugging Face TGI, Together AI, Groq, OpenRouter) hosting Gemma models
HOSTED_GEMMA_URL=""
HOSTED_GEMMA_API_KEY=""
HOSTED_GEMMA_MODEL="gemma-3-1b-it"

# App Hosting URL
APP_URL="http://localhost:3000"

